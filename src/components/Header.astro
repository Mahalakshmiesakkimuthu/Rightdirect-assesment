---
const { navItems, logo, workCards } = Astro.props;
---

<header class="site-header">
  <div class="header-container">

    <a href="/" class="logo">
      <img
        src={logo?.asset?.url}
        alt="RightDirect"
      />
    </a>

    <!-- DESKTOP NAV -->
    <nav class="main-nav">
      {navItems?.map((item) => (
        item.label === "Services" ? (
          <div class="dropdown">

            <a href={item.url} class="nav-link services-link">
              {item.label}
            </a>

            <div class="dropdown-menu">
              {workCards?.map((card) => (
                <a href="#" class="dropdown-item">
                  {card.title}
                </a>
              ))}
            </div>

          </div>
        ) : (
          <a
            href={item.url}
            class:list={[
              "nav-link",
              { "get-started": item.label === "Get Started" }
            ]}
          >
            {item.label}
          </a>
        )
      ))}
    </nav>

    <!-- MOBILE MENU -->
    <details class="mobile-menu">

      <summary
        class="menu-button"
        aria-label="Open navigation menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </summary>

      <nav class="mobile-nav">

        {navItems?.map((item) => (
          item.label === "Services" ? (
            <div class="mobile-services">

              <a href={item.url}>
                {item.label}
              </a>

              <div class="mobile-services-list">
                {workCards?.map((card) => (
                  <a href="#">
                    {card.title}
                  </a>
                ))}
              </div>

            </div>
          ) : (
            <a
              href={item.url}
              class:list={[
                { "mobile-get-started": item.label === "Get Started" }
              ]}
            >
              {item.label}
            </a>
          )
        ))}

      </nav>

    </details>

  </div>
</header>


<style>

/* =========================
   HEADER
========================= */

.site-header {
  width: 100%;
  background: #ffffff;
  border-bottom: 1px solid #eef2f6;
  position: relative;
  z-index: 1000;
}

.header-container {
  width: 100%;
  max-width: 1200px;
  min-height: 76px;

  margin: 0 auto;
  padding: 14px 40px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  box-sizing: border-box;
}


/* =========================
   LOGO
========================= */

.logo {
  display: flex;
  align-items: center;

  text-decoration: none;
  flex-shrink: 0;
}

.logo img {
  width: 150px;
  height: auto;
  display: block;
}


/* =========================
   DESKTOP NAV
========================= */

.main-nav {
  display: flex;
  align-items: center;
  gap: 28px;
}

.nav-link,
.services-link {
  position: relative;

  color: #0a2240;
  text-decoration: none;

  font-size: 14px;
  font-weight: 500;

  white-space: nowrap;

  padding: 8px 10px;

  border-radius: 15px;

  transition:
    color 0.25s ease,
    background 0.25s ease;
}


/* NAV HOVER */

.nav-link:hover,
.services-link:hover {
  color: #004681;
  background: #eaf3fa;
}


/* GET STARTED */

.get-started {
  background: #004681 !important;
  color: white !important;

  padding: 11px 20px !important;

  border-radius: 30px;
}

.get-started:hover {
  background: #00365f !important;
  color: white !important;
}


/* =========================
   SERVICES DROPDOWN
========================= */

.dropdown {
  position: relative;
}

.dropdown-menu {
  position: absolute;

  top: calc(100% + 8px);
  left: 50%;

  width: 280px;

  padding: 10px;

  background: white;

  border: 1px solid #e9eff4;
  border-radius: 12px;

  box-shadow: 0 15px 40px rgba(10, 34, 64, 0.12);

  opacity: 0;
  visibility: hidden;

  transform: translate(-50%, 10px);

  transition:
    opacity 0.25s ease,
    visibility 0.25s ease,
    transform 0.25s ease;

  z-index: 2000;
}

.dropdown:hover .dropdown-menu {
  opacity: 1;
  visibility: visible;
  transform: translate(-50%, 0);
}

.dropdown-item {
  display: block;

  padding: 12px 14px;

  color: #0a2240;

  text-decoration: none;

  font-size: 14px;

  border-radius: 8px;

  transition:
    background 0.2s ease,
    color 0.2s ease;
}

.dropdown-item:hover {
  background: #eaf3fa;
  color: #004681;
}


/* =========================
   MOBILE MENU DEFAULT
========================= */

.mobile-menu {
  display: none;
}


/* HAMBURGER */

.menu-button {
  width: 34px;
  height: 30px;

  padding: 0;

  display: flex;
  flex-direction: column;
  justify-content: space-between;

  cursor: pointer;

  list-style: none;
}

.menu-button::-webkit-details-marker {
  display: none;
}

.menu-button::marker {
  display: none;
}

.menu-button span {
  width: 100%;
  height: 3px;

  display: block;

  background: #004681;

  border-radius: 10px;

  transition: 0.25s ease;
}


/* =========================
   MOBILE NAV
========================= */

.mobile-nav {
  position: absolute;

  top: calc(100% + 1px);
  left: 15px;
  right: 15px;

  width: auto;

  padding: 12px;

  background: white;

  border: 1px solid #e8eef3;
  border-radius: 14px;

  box-shadow: 0 15px 40px rgba(10, 34, 64, 0.15);

  display: flex;
  flex-direction: column;
  gap: 4px;

  z-index: 3000;
}

.mobile-nav > a,
.mobile-services > a {
  display: block;

  padding: 13px 14px;

  color: #0a2240;

  text-decoration: none;

  font-size: 15px;

  border-radius: 8px;

  transition: 0.2s ease;
}

.mobile-nav > a:hover,
.mobile-services > a:hover {
  background: #eaf3fa;
  color: #004681;
}


/* =========================
   MOBILE SERVICES
========================= */

.mobile-services-list {
  padding: 0 10px 8px 20px;

  display: flex;
  flex-direction: column;
  gap: 2px;
}

.mobile-services-list a {
  padding: 9px 10px;

  color: #526273;

  font-size: 13px;

  text-decoration: none;

  border-radius: 6px;
}

.mobile-services-list a:hover {
  background: #f1f6fa;
  color: #004681;
}


/* GET STARTED MOBILE */

.mobile-get-started {
  margin-top: 6px;

  background: #004681 !important;
  color: white !important;

  text-align: center;
}


/* =========================
   TABLET
========================= */

@media screen and (max-width: 900px) {

  .header-container {
    padding: 14px 25px;
  }

  .logo img {
    width: 135px;
  }

  .main-nav {
    gap: 15px;
  }

  .nav-link,
  .services-link {
    font-size: 13px;
  }

}


/* =========================
   MOBILE
========================= */

@media screen and (max-width: 768px) {

  .header-container {
    min-height: 68px;
    padding: 13px 20px;
  }

  .logo img {
    width: 125px;
  }

  /* Hide desktop menu */
  .main-nav {
    display: none;
  }

  /* Show hamburger */
  .mobile-menu {
    display: block;
    position: relative;
  }

}


/* =========================
   SMALL MOBILE
========================= */

@media screen and (max-width: 400px) {

  .header-container {
    padding: 12px 16px;
  }

  .logo img {
    width: 115px;
  }

  .mobile-nav {
    left: 10px;
    right: 10px;
  }

}

</style>