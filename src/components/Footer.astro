---
import {
  FaEnvelope,
  FaPhone,
  FaLinkedinIn,
  FaFacebookF,
  FaWhatsapp
} from "react-icons/fa";

const {
  footerDescription,
  footerServices,
  footerCompany,
  footerSuccessStories,
  footerEmail,
  footerPhone,
  footerAddress,
  footerLogoUrl
} = Astro.props;
---

<footer class="footer">

  <div class="footer-container">

    
    <div class="footer-brand">

      {footerLogoUrl && (
        <img
          src={footerLogoUrl}
          alt="RightDirect"
          class="footer-logo"
        />
      )}

      <p>
        {footerDescription}
      </p>

      <img
        src="/images/google-partner.png"
        alt="Google Partner"
        class="google-partner"
      />

    </div>


    
    <div class="footer-column">

      <h3>Services</h3>

      {footerServices?.map((item) => (
        <a href={item.url}>
          {item.label}
        </a>
      ))}

    </div>


    
    <div class="footer-column">

      <h3>Company</h3>

      {footerCompany?.map((item) => (
        <a href={item.url}>
          {item.label}
        </a>
      ))}

    </div>


   
    <div class="footer-column">

      <h3>Success Stories</h3>

      {footerSuccessStories?.map((item) => (
        <a href={item.url}>
          {item.label}
        </a>
      ))}

    </div>


    
    <div class="footer-contact">

      <h3>Contact</h3>

      <!-- EMAIL -->
      <div class="contact-item">

        <div class="contact-icon">
          <span><FaEnvelope/></span>
        </div>

        <a href={`mailto:${footerEmail}`}>
          {footerEmail}
        </a>

      </div>


      
      <div class="contact-item">

        <div class="contact-icon">
          <span><FaPhone/></span>
        </div>

        <a href={`tel:${footerPhone}`}>
          {footerPhone}
        </a>

      </div>


      
      <p class="address">
        {footerAddress}
      </p>


      
      <p class="follow-title">
        Follow Us
      </p>

      <div class="social-links">

        <a
          href="#"
          aria-label="LinkedIn"
        >
          <FaLinkedinIn />
        </a>

        <a
          href="#"
          aria-label="Facebook"
        >
          <FaFacebookF />
        </a>

        <a
          href="#"
          aria-label="WhatsApp"
        >
          <FaWhatsapp />
        </a>

      </div>

    </div>

  </div>


  
  <div class="footer-bottom">

    <p>
      © 2026 RightDirect. All rights reserved.
    </p>

  </div>

</footer>


<style>

.footer {
  background: #004681;
  color: white;
  padding: 60px 46px 30px;
}



.footer-container {
  max-width: 1240px;
  margin: 0 auto;

  display: grid;

  grid-template-columns:
    1.5fr
    1fr
    0.8fr
    1.2fr
    1.8fr;

  gap: 40px;
}



.footer-brand {
  min-width: 0;
}

.footer-logo {
  width: 70px;
  height: auto;
  margin-bottom: 25px;

  filter: brightness(0) invert(1);
}

.footer-brand p {
  max-width: 260px;

  color: #dbeafe;

  line-height: 1.8;

  margin: 0 0 35px;
}

.google-partner {
  width: 78px;
  height: auto;
}



.footer h3 {
  margin: 0 0 20px;

  font-size: 17px;
  font-weight: 600;
}



.footer-column {
  display: flex;
  flex-direction: column;
}


.footer-column a {
  color: #dbeafe;

  text-decoration: none;

  line-height: 1.6;

  margin-bottom: 12px;

  transition: color 0.2s ease;
}

.footer-column a:hover {
  color: white;
}


.footer-contact {
  border-left: 1px solid rgba(255, 255, 255, 0.18);

  padding-left: 32px;

  min-width: 0;
}


.contact-item {
  display: flex;

  align-items: center;

  gap: 12px;

  margin-bottom: 18px;
}


.contact-icon {
  width: 34px;
  height: 34px;

  flex-shrink: 0;

  border: 1px solid rgba(255, 255, 255, 0.18);

  border-radius: 50%;

  display: flex;

  align-items: center;

  justify-content: center;
}


.contact-icon span {
  font-size: 15px;
}


.contact-item a {
  color: #dbeafe;

  text-decoration: none;

  font-size: 15px;
}

.contact-item a:hover {
  color: white;
}


.address {
  color: #dbeafe;

  line-height: 1.8;

  margin: 25px 0 0;

  font-size: 15px;
}


.follow-title {
  margin: 35px 0 15px;

  color: #dbeafe;

  letter-spacing: 4px;

  font-size: 13px;
}


.social-links {
  display: flex;

  gap: 12px;
}


.social-links a {
  width: 42px;
  height: 42px;

  border: 1px solid rgba(255, 255, 255, 0.2);

  border-radius: 50%;

  display: flex;

  align-items: center;

  justify-content: center;

  color: white;

  text-decoration: none;

  transition: all 0.2s ease;
}


.social-links a svg {
  width: 19px;
  height: 19px;
}


.social-links a:hover {
  background: rgba(255, 255, 255, 0.1);
}


.footer-bottom {
  max-width: 1240px;

  margin: 45px auto 0;

  padding-top: 20px;

  border-top: 1px solid rgba(255, 255, 255, 0.2);

  text-align: center;
}


.footer-bottom p {
  margin: 0;

  color: #dbeafe;

  font-size: 14px;
}


@media (max-width: 1000px) {

  .footer-container {
    grid-template-columns: 1fr 1fr;
  }

  .footer-contact {
    border-left: none;

    padding-left: 0;
  }

}


@media (max-width: 600px) {

  .footer {
    padding: 45px 25px 30px;
  }

  .footer-container {
    grid-template-columns: 1fr;

    gap: 40px;
  }

  .footer-contact {
    border-left: none;

    padding-left: 0;
  }

  .footer-logo {
    width: 65px;
  }

}

</style>