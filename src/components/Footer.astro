---
import {
  FaEnvelope,
  FaPhone,
  FaLinkedinIn,
  FaFacebookF,
  FaWhatsapp
} from "react-icons/fa";

const {
  footerDescription,
  footerServices,
  footerCompany,
  footerSuccessStories,
  footerEmail,
  footerPhone,
  footerAddress,
  footerLogoUrl
} = Astro.props;
---

<footer class="footer">

  <div class="footer-container">

    <div class="footer-brand">

      {footerLogoUrl && (
        <img
          src={footerLogoUrl}
          alt="RightDirect"
          class="footer-logo"
        />
      )}

      <p>
        {footerDescription}
      </p>

      <img
        src="/images/google-partner.png"
        alt="Google Partner"
        class="google-partner"
      />

    </div>

    <div class="footer-column">

      <h3>Services</h3>

      {footerServices?.map((item) => (
        <a href={item.url}>
          {item.label}
        </a>
      ))}

    </div>

    <div class="footer-column">

      <h3>Company</h3>

      {footerCompany?.map((item) => (
        <a href={item.url}>
          {item.label}
        </a>
      ))}

    </div>

    <div class="footer-column">

      <h3>Success Stories</h3>

      {footerSuccessStories?.map((item) => (
        <a href={item.url}>
          {item.label}
        </a>
      ))}

    </div>

    <div class="footer-contact">

      <h3>Contact</h3>

      <div class="contact-item">

        <div class="contact-icon">
          <FaEnvelope />
        </div>

        <a href={`mailto:${footerEmail}`}>
          {footerEmail}
        </a>

      </div>

      <div class="contact-item">

        <div class="contact-icon">
          <FaPhone />
        </div>

        <a href={`tel:${footerPhone}`}>
          {footerPhone}
        </a>

      </div>

      <p class="address">
        {footerAddress}
      </p>


      <p class="follow-title">
        Follow Us
      </p>

      <div class="social-links">

        <a
          href="#"
          aria-label="LinkedIn"
        >
          <FaLinkedinIn />
        </a>

        <a
          href="#"
          aria-label="Facebook"
        >
          <FaFacebookF />
        </a>

        <a
          href="#"
          aria-label="WhatsApp"
        >
          <FaWhatsapp />
        </a>

      </div>

    </div>

  </div>


  <div class="footer-bottom">

    <p>
      © 2026 RightDirect. All rights reserved.
    </p>

  </div>

</footer>


<style>

.footer {
  width: 100%;

  background: #004681;

  color: white;

  padding: 60px 40px 30px;

  box-sizing: border-box;

  overflow: hidden;
}


.footer-container {
  width: 100%;
  max-width: 1240px;

  margin: 0 auto;

  display: grid;

  grid-template-columns:
    1.5fr
    1fr
    0.9fr
    1.2fr
    1.8fr;

  gap: 35px;

  box-sizing: border-box;
}


.footer-brand {
  min-width: 0;
}

.footer-logo {
  width: 70px;
  height: auto;

  display: block;

  margin-bottom: 22px;

  filter: brightness(0) invert(1);
}

.footer-brand p {
  max-width: 270px;

  margin: 0 0 30px;

  color: #dbeafe;

  font-size: 14px;

  line-height: 1.75;
}

.google-partner {
  width: 78px;
  height: auto;

  display: block;
}

.footer-column {
  min-width: 0;

  display: flex;
  flex-direction: column;
}

.footer h3 {
  margin: 0 0 18px;

  color: white;

  font-size: 16px;

  font-weight: 600;
}

.footer-column a {
  color: #dbeafe;

  text-decoration: none;

  font-size: 14px;

  line-height: 1.55;

  margin-bottom: 10px;

  transition: color 0.2s ease;
}

.footer-column a:hover {
  color: white;
}

.footer-contact {
  min-width: 0;

  padding-left: 28px;

  border-left: 1px solid rgba(255, 255, 255, 0.18);

  box-sizing: border-box;
}

.contact-item {
  width: 100%;

  display: flex;
  align-items: center;

  gap: 10px;

  margin-bottom: 16px;

  min-width: 0;
}

.contact-icon {
  width: 34px;
  height: 34px;

  flex: 0 0 34px;

  border: 1px solid rgba(255, 255, 255, 0.2);

  border-radius: 50%;

  display: flex;
  align-items: center;
  justify-content: center;
}

.contact-icon svg {
  width: 14px;
  height: 14px;
}

.contact-item a {
  min-width: 0;

  color: #dbeafe;

  text-decoration: none;

  font-size: 14px;

  overflow-wrap: anywhere;
}

.contact-item a:hover {
  color: white;
}


.address {
  margin: 22px 0 0;

  color: #dbeafe;

  font-size: 14px;

  line-height: 1.7;
}

.follow-title {
  margin: 28px 0 14px;

  color: #dbeafe;

  font-size: 12px;

  letter-spacing: 3px;

  font-weight: 600;
}

.social-links {
  display: flex;

  gap: 10px;
}

.social-links a {
  width: 40px;
  height: 40px;

  display: flex;
  align-items: center;
  justify-content: center;

  color: white;

  text-decoration: none;

  border: 1px solid rgba(255, 255, 255, 0.2);

  border-radius: 50%;

  transition:
    background 0.2s ease,
    transform 0.2s ease;
}

.social-links a svg {
  width: 17px;
  height: 17px;
}

.social-links a:hover {
  background: rgba(255, 255, 255, 0.12);

  transform: translateY(-2px);
}


.footer-bottom {
  width: 100%;
  max-width: 1240px;

  margin: 45px auto 0;

  padding-top: 20px;

  border-top: 1px solid rgba(255, 255, 255, 0.2);

  text-align: center;

  box-sizing: border-box;
}

.footer-bottom p {
  margin: 0;

  color: #dbeafe;

  font-size: 13px;
}


@media (max-width: 1050px) {

  .footer {
    padding: 55px 30px 30px;
  }

  .footer-container {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 40px 35px;
  }

  .footer-brand {
    grid-column: span 2;
  }

  .footer-brand p {
    max-width: 450px;
  }

  .footer-contact {
    border-left: none;

    padding-left: 0;
  }

}


@media (max-width: 600px) {

  .footer {
    padding: 45px 20px 25px;
  }

  .footer-container {
    width: 100%;

    grid-template-columns: 1fr;

    gap: 32px;
  }

  .footer-brand {
    grid-column: auto;
  }

  .footer-brand p {
    max-width: 100%;

    font-size: 13px;
  }

  .footer-logo {
    width: 65px;

    margin-bottom: 18px;
  }

  .footer-column {
    width: 100%;
  }

  .footer-column a {
    font-size: 13px;

    margin-bottom: 9px;
  }

  .footer-contact {
    width: 100%;

    border-left: none;

    padding-left: 0;
  }

  .contact-item {
    max-width: 100%;
  }

  .contact-item a {
    font-size: 13px;
  }

  .address {
    font-size: 13px;

    max-width: 350px;
  }

  .footer-bottom {
    margin-top: 35px;

    padding-top: 18px;
  }

  .footer-bottom p {
    font-size: 12px;

    line-height: 1.5;
  }

}



@media (max-width: 380px) {

  .footer {
    padding: 40px 16px 22px;
  }

  .footer-container {
    gap: 28px;
  }

  .footer h3 {
    font-size: 15px;
  }

  .footer-brand p,
  .footer-column a,
  .contact-item a,
  .address {
    font-size: 12px;
  }

}

</style>