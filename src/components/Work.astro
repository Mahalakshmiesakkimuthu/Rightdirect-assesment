
---
import {
  Lightbulb,
  Code2,
  Send,
  Grid2X2
} from "lucide-astro";

const { workCards } = Astro.props;
---

<section class="work">

  <div class="work-container">

    <div class="work-header">
      <p>Work</p>
    </div>

    <div class="work-grid">

      {workCards?.map((card, index) => (

        <article class="work-card">

          <div class="work-top">

            <span class="work-number">
              {card.number}
            </span>

            <div class="work-icon">

              {index === 0 && <Lightbulb />}

              {index === 1 && <Code2 />}

              {index === 2 && <Send />}

              {index >= 3 && <Grid2X2 />}

            </div>

          </div>

          <h3>
            {card.title}
          </h3>

          <p class="work-description">
            {card.description}
          </p>

          <a
            href={card.ctaUrl || "#"}
            class="work-link"
          >
            {card.cta}
          </a>

          {card.imageUrl && (
            <img
              src={card.imageUrl}
              alt={card.title}
              class="work-image"
              loading="lazy"
            />
          )}

        </article>

      ))}

    </div>

  </div>

</section>


<style>

  .work {
    width: 100%;
    max-width: 100%;
    background: #f7faff;
    overflow-x: clip;
    overflow-y: visible;
    box-sizing: border-box;
  }

  .work-container {
    width: 100%;
    max-width: 1250px;
    margin: 0 auto;
    padding: 75px 40px;
    box-sizing: border-box;
  }

  .work-header {
    width: 100%;
    margin: 0 0 42px;
    text-align: center;
    box-sizing: border-box;
  }

  .work-header p {
    margin: 0;
    color: #07579d;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.4;
  }

  .work-grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    box-sizing: border-box;
    align-items: stretch;
  }

  .work-card {
    position: relative;

    width: 100%;
    min-width: 0;
    max-width: 100%;

    padding: 22px;

    background: #ffffff;

    border: 1px solid #e5edf5;
    border-radius: 16px;

    box-shadow:
      0 7px 22px rgba(10, 34, 64, 0.08);

    display: flex;
    flex-direction: column;

    box-sizing: border-box;

    overflow: hidden;

    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .work-card:hover {
    transform: translateY(-6px);

    box-shadow:
      0 14px 32px rgba(10, 34, 64, 0.14);
  }

  .work-top {
    width: 100%;

    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    gap: 12px;

    box-sizing: border-box;
  }


  /* ========================================
     NUMBER
     ======================================== */

  .work-number {
    display: block;

    color: #b8ddf2;

    font-size: 42px;
    line-height: 1;
    font-weight: 700;

    flex-shrink: 0;
  }

  .work-icon {
    width: 42px;
    height: 42px;

    min-width: 42px;
    flex: 0 0 42px;

    border-radius: 50%;

    background: #e8f0f6;
    color: #005a9c;

    display: flex;
    align-items: center;
    justify-content: center;

    box-sizing: border-box;
  }

  .work-icon svg {
    width: 20px;
    height: 20px;
    display: block;
  }

  .work-card h3 {
    margin: 24px 0 12px;

    color: #0a2240;

    font-size: 19px;
    line-height: 1.3;
    font-weight: 600;

    overflow-wrap: anywhere;
  }

  .work-description {
    margin: 0 0 18px;

    color: #526273;

    font-size: 14px;
    line-height: 1.6;

    overflow-wrap: anywhere;
    word-break: normal;
  }

  .work-link {
    display: inline-flex;
    align-items: center;

    width: fit-content;
    max-width: 100%;

    margin-top: auto;
    padding: 4px 0;

    color: #07579d;

    font-size: 14px;
    line-height: 1.4;
    font-weight: 600;

    text-decoration: none;

    visibility: visible;
    opacity: 1;

    position: relative;
    z-index: 2;

    overflow-wrap: anywhere;
    word-break: break-word;

    transition:
      transform 0.2s ease,
      color 0.2s ease;
  }

  .work-link:hover {
    color: #004681;
    transform: translateX(4px);
  }

  .work-image {
    display: block;

    width: 100%;
    max-width: 100%;

    height: 125px;

    margin-top: 22px;

    object-fit: cover;

    border-radius: 10px;

    box-sizing: border-box;
  }


 @media screen and (max-width: 768px) {

  .work-container {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 50px 40px 45px;
    box-sizing: border-box;
  }

  .work-header {
    width: 100%;
    margin: 0 0 40px;
    text-align: center;
  }

  .work-header p {
    font-size: 30px;
    line-height: 1.3;
  }

  .work-grid {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    gap: 25px;
  }

  .work-card {
    width: 100%;
    min-width: 0;
    padding: 32px;
    border-radius: 16px;
    box-sizing: border-box;
  }

  .work-top {
    width: 100%;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  .work-number {
    font-size: 42px;
  }

  .work-icon {
    width: 58px;
    height: 58px;
    min-width: 58px;
    flex: 0 0 58px;
  }

  .work-icon svg {
    width: 25px;
    height: 25px;
  }

  .work-card h3 {
    margin: 28px 0 18px;
    font-size: 25px;
    line-height: 1.3;
  }

  .work-description {
    margin: 0 0 25px;
    font-size: 18px;
    line-height: 1.55;
  }

  .work-link {
    margin-top: 0;
    font-size: 17px;
  }

  .work-image {
    width: 100%;
    height: 330px;
    margin-top: 28px;
    object-fit: cover;
    border-radius: 12px;
  }
}
@media (max-width: 768px) {
  .work {
    outline: 5px solid red;
  }
}
</style>

