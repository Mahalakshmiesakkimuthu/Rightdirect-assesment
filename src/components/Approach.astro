---
import { Users, Wallet, Handshake } from "lucide-astro";

const {
  approachLabel,
  approachTitle,
  approachDescription,
  approachCards
} = Astro.props;
---

<div class="content">

  <div class="left">
    <p>{approachLabel}</p>

    <h2 class="textt">
      {approachTitle}
    </h2>

    <p>
      {approachDescription}
    </p>
  </div>

  <div class="right">
    {approachCards?.map((card) => (
      <div class="card">

        <div class="icon-circle">
          {card.title === "The Right Team at the Right Time" && (
            <Users size={24} />
          )}

          {card.title === "Pay Only for What Matters" && (
            <Wallet size={24} />
          )}

          {card.title === "Partner-Level Support" && (
            <Handshake size={24} />
          )}
        </div>

        <h3 class="text">
          {card.title}
        </h3>

      </div>
    ))}
  </div>

</div>

<style>

  .content {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 90px 60px;

    display: grid;
    grid-template-columns: 1fr 0.9fr;
    gap: 70px;
    align-items: center;

    box-sizing: border-box;
  }

  .left {
    width: 100%;
    min-width: 0;
  }

  .left > p:first-child {
    margin: 0 0 18px;
    color: #0a2240;
    font-size: 15px;
    font-weight: 600;
  }

  .textt {
    margin: 0 0 24px;
    color: #004681;
    font-size: 32px;
    line-height: 1.25;
    font-weight: 700;
  }

  .left > p:last-child {
    margin: 0;
    color: #526273;
    font-size: 16px;
    line-height: 1.7;
  }

  .right {
    width: 100%;
    min-width: 0;

    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .card {
    width: 100%;
    min-height: 100px;
    padding: 0 25px;

    display: flex;
    align-items: center;
    gap: 20px;

    background: white;
    border-radius: 12px;

    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.18);

    box-sizing: border-box;

    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
  }

  .icon-circle {
    width: 44px;
    height: 44px;
    min-width: 44px;
    flex-shrink: 0;

    border-radius: 50%;
    background: #e7f0f8;

    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon-circle svg {
    width: 22px;
    height: 22px;
    color: #0065a8;
  }

  .text {
    margin: 0;
    padding: 0;

    color: #004681;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.4;

    min-width: 0;
    overflow-wrap: break-word;
    word-break: normal;
  }



 @media screen and (max-width: 900px) {
  .content {
    padding: 75px 40px;
    grid-template-columns: 1fr;
    gap: 45px;
  }

  .textt {
    font-size: 30px;
  }
}

@media screen and (max-width: 600px) {
  .content {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 50px 16px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 35px;
    box-sizing: border-box;
  }

  .left {
    width: 100%;
  }

  .left > p:first-child {
    margin-bottom: 14px;
    font-size: 15px;
  }

  .textt {
    margin-bottom: 18px;
    font-size: 28px;
    line-height: 1.3;
  }

  .left > p:last-child {
    font-size: 15px;
    line-height: 1.7;
  }

  .right {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .card {
    width: 100%;
    min-height: 90px;
    padding: 20px 18px;
    display: flex;
    align-items: center;
    gap: 15px;
    box-sizing: border-box;
  }

  .icon-circle {
    width: 42px;
    height: 42px;
    min-width: 42px;
    flex: 0 0 42px;
  }

  .icon-circle svg {
    width: 21px;
    height: 21px;
  }

  .text {
    flex: 1;
    min-width: 0;
    font-size: 17px;
    line-height: 1.4;
  }
}

@media screen and (max-width: 400px) {
  .content {
    padding: 45px 16px;
    gap: 30px;
  }

  .textt {
    font-size: 24px;
  }

  .left > p:last-child {
    font-size: 14px;
  }

  .right {
    gap: 12px;
  }

  .card {
    min-height: 72px;
    padding: 15px;
    gap: 13px;
  }

  .icon-circle {
    width: 40px;
    height: 40px;
    min-width: 40px;
    flex: 0 0 40px;
  }

  .text {
    font-size: 15px;
  }
}
@media screen and (max-width: 768px) {
  .content {
    width: 100%;
    padding: 50px 16px;
    display: flex;
    flex-direction: column;
    gap: 30px;
    box-sizing: border-box;
  }

  .left {
    width: 100%;
  }

  .textt {
    font-size: 27px;
    line-height: 1.3;
  }

  .left > p:last-child {
    font-size: 15px;
    line-height: 1.7;
  }

  .right {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .card {
    width: 100%;
    min-height: 90px;
    padding: 18px;
    box-sizing: border-box;
  }

  .text {
    font-size: 16px;
  }
}
</style>