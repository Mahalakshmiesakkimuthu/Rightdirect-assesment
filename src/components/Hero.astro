---
import { BriefcaseBusiness } from "lucide-astro";

const { heroTitle, heroSubtitle } = Astro.props;
---

<section class="hero">

  <div class="hero-container">

    <div class="hero-icon">
      <BriefcaseBusiness />
    </div>

    <h1>{heroTitle}</h1>

    <p>{heroSubtitle}</p>

  </div>

</section>


<style>

.hero {
  width: 100%;
  overflow: hidden;
}

.hero-container {
  width: 100%;
  min-height: 300px;

  padding: 50px 30px;

  background: #0a2240;
  color: white;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  text-align: center;

  box-sizing: border-box;
}

.hero-icon {
  width: 52px;
  height: 52px;

  margin-bottom: 22px;

  border-radius: 50%;

  background: #336b9a;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;
}

.hero-icon svg {
  width: 27px;
  height: 27px;
}


.hero-container h1 {
  width: 100%;
  max-width: 900px;

  margin: 0 0 15px;

  font-size: 42px;
  line-height: 1.2;

  font-weight: 700;

  color: white;
}


.hero-container p {
  width: 100%;
  max-width: 800px;

  margin: 0;

  color: #dbeafe;

  font-size: 16px;
  line-height: 1.6;
}


@media (max-width: 768px) {

  .hero-container {
    min-height: 270px;
    padding: 45px 25px;
  }

  .hero-container h1 {
    font-size: 34px;
  }

  .hero-container p {
    font-size: 15px;
  }

}


@media (max-width: 600px) {

  .hero-container {
    min-height: 240px;

    padding: 40px 20px;
  }

  .hero-icon {
    width: 46px;
    height: 46px;

    margin-bottom: 18px;
  }

  .hero-icon svg {
    width: 23px;
    height: 23px;
  }

  .hero-container h1 {
    font-size: 29px;
    line-height: 1.2;

    margin-bottom: 12px;
  }

  .hero-container p {
    max-width: 340px;

    font-size: 13px;
    line-height: 1.55;
  }

}


@media (max-width: 400px) {

  .hero-container {
    min-height: 220px;

    padding: 35px 16px;
  }

  .hero-container h1 {
    font-size: 25px;
  }

  .hero-container p {
    font-size: 12px;
  }

}

</style>