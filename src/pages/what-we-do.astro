---
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Approach from "../components/Approach.astro";
import { sanityClient } from "../lib/sanity";
import Work from "../components/Work.astro";
import Footer from "../components/Footer.astro";
const data = await sanityClient.fetch(`
  *[_type == "servicesPage"][0]{
    heroTitle,
    heroSubtitle,
    approachLabel,
    approachTitle,
    approachDescription,
    approachCards[]{
      title
    },
    workCards[]{
      number,
      title,
      description,
      cta,
      "imageUrl": image.asset->url
    },
    logo{
  asset->{
    url
  }
},
    navItems[]{
  label,
  url
},
    seoTitle,
    seoDescription,
    footerDescription,
footerServices[]{
  label,
  url
},
footerCompany[]{
  label,
  url
},
footerSuccessStories[]{
  label,
  url
},
footerEmail,
footerPhone,
footerAddress,
"footerLogoUrl": footerLogo.asset->url
  }
`);
---
<head>
  <title>{data.seoTitle}</title>
  <meta
    name="description"
    content={data.seoDescription}
  />
  <link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
  rel="stylesheet"
/>
</head>

<Header
 navItems={data.navItems} 
logo={data.logo}
workCards={data.workCards}
/>

<Hero 
  heroTitle={data.heroTitle}
  heroSubtitle={data.heroSubtitle}
/>

<Approach
  approachLabel={data.approachLabel}
  approachTitle={data.approachTitle}
  approachDescription={data.approachDescription}
  approachCards={data.approachCards}
/>

<Work workCards={data.workCards} />
<Footer
  footerDescription={data.footerDescription}
  footerServices={data.footerServices}
  footerCompany={data.footerCompany}
  footerSuccessStories={data.footerSuccessStories}
  footerEmail={data.footerEmail}
  footerPhone={data.footerPhone}
  footerAddress={data.footerAddress}
  footerLogoUrl={data.footerLogoUrl}
/>

<style>
html,
body {
  font-family: "Inter", sans-serif;
}

* {
  font-family: inherit;
}
</style>